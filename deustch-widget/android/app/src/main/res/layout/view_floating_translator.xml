<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bubble"
        android:contentDescription="@string/cd_bubble"
        android:elevation="8dp"
        android:gravity="center"
        android:text="De"
        android:textColor="@color/card"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dragHandle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/closeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_quiet"
                android:contentDescription="@string/cd_close"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/close"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sourceLang"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_quiet"
                android:gravity="center"
                android:text="Auto-detect"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/swapButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_quiet"
                android:contentDescription="@string/cd_swap"
                android:gravity="center"
                android:text="⇄"
                android:textColor="@color/accent"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/targetLang"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_quiet"
                android:gravity="center"
                android:text="German"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/languagePicker"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/languageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </ScrollView>

        <TextView
            android:id="@+id/pairLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/sourceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="@string/source_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textDirection="firstStrong"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/translateButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:text="@string/translate"
            android:textAllCaps="false"
            android:textColor="@color/card"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field"
            android:maxLines="6"
            android:minLines="2"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:text="@string/result_placeholder"
            android:textColor="@color/ink"
            android:textDirection="firstStrong"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/error"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/copyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_quiet"
                android:contentDescription="@string/cd_copy"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/copy"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/engine_caption"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
