# Supabase (required for authentication)
# Next.js uses NEXT_PUBLIC_ prefix for client-side env vars
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vite equivalent (if migrating to Vite)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_APP_URL=http://localhost:5173

# NEVER add the Supabase service role key to frontend code or this file.

# Demo request form (Resend) — https://resend.com/api-keys
RESEND_API_KEY=
DEMO_REQUEST_EMAIL=pratikrughe.qlimwelt@gmail.com
# Optional: use your verified domain in production, e.g. Qlimwelt <noreply@qlimwelt.de>
RESEND_FROM=Qlimwelt <onboarding@resend.dev>
