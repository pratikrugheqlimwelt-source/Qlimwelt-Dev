# Supabase (required for authentication)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEVER add the Supabase service role key to frontend code or this file.

# Demo request form (Resend) — https://resend.com/api-keys
RESEND_API_KEY=
DEMO_REQUEST_EMAIL=pratikrughe.qlimwelt@gmail.com
RESEND_FROM=Qlimwelt <onboarding@resend.dev>

# --- Qlim AI ---
# Local (Ollama — carbon consultant model):
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# After: ollama create qlimwelt-carbon -f ollama/Modelfile
LLM_MODEL=qlimwelt-carbon

# Vercel / production (Ollama cannot run on Vercel serverless):
# Set these in the Vercel project → Settings → Environment Variables
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant
# Same carbon consultant system prompt is used for both Ollama and Groq.

# Or any OpenAI-compatible endpoint (Together, OpenRouter, LM Studio, etc.)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=
# LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct-Turbo
